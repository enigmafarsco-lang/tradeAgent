# گزینه‌ی جایگزین systemd: یک چرخه در هر ۵ دقیقه (بدون حلقه‌ی مقیم)
# نصب: crontab -e  و این خط را اضافه کن (مسیر را اصلاح کن)
#
# */5 * * * * cd $HOME/tradeAgent && ./.venv/bin/tradeagent cycle >> var/logs/cron.log 2>&1
#
# نکته: cron اگر چرخه‌ی قبلی طول بکشد دو اجرا را روی هم می‌اندازد؛ قفل داخلی
# جلوی تداخل را می‌گیرد ولی اجرای دوم در لاگ خطا می‌دهد. systemd + `loop`
# گزینه‌ی تمیزتر است.
