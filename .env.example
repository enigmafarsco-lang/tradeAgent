# ─── مدل زبانی ────────────────────────────────────────────────────────────
# Gemini رایگان: https://aistudio.google.com/apikey
# کلید فقط در محیط می‌ماند؛ هرگز در TOML یا گیت نوشته نمی‌شود.
GEMINI_API_KEY=

# Ollama محلی (بدون کلید). مدل را یک بار pull کن:
#   ollama pull qwen2.5:7b-instruct
#   export TRADEAGENT_LLM_PROVIDER=ollama
TRADEAGENT_LLM_PROVIDER=gemini
TRADEAGENT_LLM_MODEL=gemini-2.5-flash
TRADEAGENT_OLLAMA_URL=http://127.0.0.1:11434
TRADEAGENT_OLLAMA_MODEL=qwen2.5:7b-instruct

# ─── داده ─────────────────────────────────────────────────────────────────
# harvester = خواندن واقعی از متاتریدر، synthetic = داده‌ی ساختگی
TRADEAGENT_SOURCE=harvester
# مسیر واقعی را با scripts/find_mt5_data.sh پیدا کن
TRADEAGENT_HARVESTER_DIR=~/mt5/MQL5/Files/harvester
TRADEAGENT_STALE_AFTER_S=180

# ─── معامله‌ی کاغذی ────────────────────────────────────────────────────────
TRADEAGENT_BALANCE=10000
TRADEAGENT_RISK_PCT=0.5

# ─── انتشار گزارش ─────────────────────────────────────────────────────────
TRADEAGENT_PUBLISH=true
TRADEAGENT_PUBLISH_BRANCH=reports
# خالی = همان origin ریپوی کد
TRADEAGENT_PUBLISH_REMOTE=

TRADEAGENT_LOG_LEVEL=INFO
